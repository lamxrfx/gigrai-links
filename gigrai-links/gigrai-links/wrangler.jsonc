{
  "name": "gigrai-links",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // These pages go through worker.js first, which adds Google tags and role-link previews
    "run_worker_first": ["/", "/index.html", "/privacy", "/privacy.html"]
  },
  // Anonymous visit and click counts (media kit and sponsor reports). See stats.js
  "durable_objects": {
    "bindings": [
      { "name": "STATS", "class_name": "Stats" },
      // News headlines and blog posts. See content.js
      { "name": "CONTENT", "class_name": "Content" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Stats"] },
    { "tag": "v2", "new_sqlite_classes": ["Content"] }
  ],
  // Emails us new booking requests from /advertise (Cloudflare Email Routing; the address must be a verified destination)
  "send_email": [{ "name": "NOTIFY", "destination_address": "remotegigr.ai@gmail.com" }],
  // Pull the latest news headlines every hour (see news-sources.js)
  // Free AI for the GigrAI assistant (see chat.js)
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["7 * * * *"] },
  "observability": {
    "enabled": true
  },
  "vars": {
    "MAILERLITE_GROUP_ID": "201853461247034816",
    // Google AdSense publisher ID, e.g. "ca-pub-1234567890123456". Leave empty for no ads.
    // When set, the AdSense code and /ads.txt switch on automatically.
    "ADSENSE_CLIENT": "ca-pub-9842961043523844",
    // Google Search Console "HTML tag" code (just the content="..." value). Optional.
    "GOOGLE_SITE_VERIFICATION": "",
    // Email job alerts: "off" until the ICO fee is paid and MailerLite has the business address.
    // Set to "on" to switch every "Job alerts" button to the email sign-up (WhatsApp stays as an option).
    "EMAIL_SIGNUP": "on",
    // GigrAI assistant chat bubble: "on" or "off"
    "CHAT": "on",
    // Who writes the replies: "workers-ai" (free) or "anthropic" (Claude, needs the ANTHROPIC_API_KEY secret)
    "CHAT_PROVIDER": "workers-ai",
    // Most AI replies a day for the whole site (keeps Workers AI inside its free daily allowance).
    // After that, people still get matching roles, just without a written answer.
    "CHAT_DAILY_CAP": "150"
  }
  // REPORT_SECRET is a secret (set by the GitHub deploy workflow) that signs private report links
  // MAILERLITE_TOKEN is a secret set in the Cloudflare dashboard (not stored here)
}
